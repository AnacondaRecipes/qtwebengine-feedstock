From: QtWebEngine software rendering fix
Subject: [PATCH] Keep ANGLE available for the software scene graph (D3D11 WARP)

When the Qt Quick scene graph renders in software (for example after
QQuickWindow::setGraphicsApi(QSGRendererInterface::Software), or with
QT_QUICK_BACKEND=software), getGLType() returned "disabled", which makes
Chromium skip GL initialization and its SwiftShader fallback entirely. WebGL
then fails with

  ERROR:gpu_channel_manager.cc:920] Failed to create GLES3 context, fallback to GLES2.
  ERROR:gpu_channel_manager.cc:931] ContextResult::kFatalFailure: Failed to create shared context for virtualization.

and canvas.getContext('webgl2') returns null.

What the patch does:
  - Detects the software scene graph through
    QQuickWindow::sceneGraphBackend()/QT_QUICK_BACKEND. QQuickWindow::graphicsApi()
    does not reflect a setGraphicsApi(Software) request, it keeps reporting the
    default API, which is what made the old detection fail.
  - Requests --use-gl=angle --use-angle=d3d11-warp instead of --use-gl=disabled
    for that case. D3D11 WARP is a CPU rasterizer that ships with Windows, so
    WebGL, accelerated 2D canvas and rasterization work without a GPU and
    without shipping additional runtime files.
  - Keeps compositing on the CPU with --disable-gpu-compositing, because a
    software scene graph cannot present GPU composited frames. Without that
    switch the page renders blank.
  - Skips the adapter LUID switch for the software scene graph.

An explicit --use-gl/--use-angle on the command line still takes precedence.

Platforms:
  Windows only (Q_OS_WIN). Non-Windows behavior is unchanged.

---
diff --git a/src/core/web_engine_context.cpp b/src/core/web_engine_context.cpp
--- a/src/core/web_engine_context.cpp
+++ b/src/core/web_engine_context.cpp
@@ -143,6 +143,28 @@
             && isInFeatureList(switches::kEnableFeatures);
 }
 
+static QString sceneGraphBackendName()
+{
+    const QStringList args = QGuiApplication::arguments();
+
+    // follow the logic from contextFactory in src/quick/scenegraph/qsgcontextplugin.cpp
+    QString device = QQuickWindow::sceneGraphBackend();
+
+    for (int index = 0; index < args.count(); ++index) {
+        if (args.at(index).startsWith("--device="_L1)) {
+            device = args.at(index).mid(9);
+            break;
+        }
+    }
+
+    if (device.isEmpty())
+        device = qEnvironmentVariable("QT_QUICK_BACKEND");
+    if (device.isEmpty())
+        device = qEnvironmentVariable("QMLSCENE_DEVICE");
+
+    return device;
+}
+
 static bool usingSupportedSGBackend()
 {
     if (QQuickWindow::graphicsApi() != QSGRendererInterface::OpenGL
@@ -151,24 +173,23 @@
         && QQuickWindow::graphicsApi() != QSGRendererInterface::Direct3D11)
         return false;
 
-    const QStringList args = QGuiApplication::arguments();
-
-    // follow the logic from contextFactory in src/quick/scenegraph/qsgcontextplugin.cpp
-    QString device = QQuickWindow::sceneGraphBackend();
-
-    for (int index = 0; index < args.count(); ++index) {
-        if (args.at(index).startsWith("--device="_L1)) {
-            device = args.at(index).mid(9);
-            break;
-        }
-    }
-
-    if (device.isEmpty())
-        device = qEnvironmentVariable("QT_QUICK_BACKEND");
-    if (device.isEmpty())
-        device = qEnvironmentVariable("QMLSCENE_DEVICE");
-
+    const QString device = sceneGraphBackendName();
     return device.isEmpty() || device == "rhi"_L1;
+}
+
+// The Qt Quick software backend cannot share GL contexts or textures with
+// Chromium, but WebGL and accelerated 2D canvas still need a GL implementation.
+// Detect it so that a software GL implementation can be used instead of
+// disabling GL altogether.
+static bool usingSoftwareSGBackend()
+{
+#if defined(Q_OS_WIN)
+    // ANGLE's D3D11 WARP backend is only selected on Windows, it is part of the
+    // operating system and needs no additional runtime.
+    return sceneGraphBackendName() == "software"_L1;
+#else
+    return false;
+#endif
 }
 
 static std::string getGLType(const base::CommandLine &cmd)
@@ -176,7 +197,13 @@
     if (cmd.HasSwitch(switches::kUseGL))
         return cmd.GetSwitchValueASCII(switches::kUseGL);
 
-    if (!usingSupportedSGBackend() || cmd.HasSwitch(switches::kDisableGpu))
+    if (cmd.HasSwitch(switches::kDisableGpu))
+        return gl::kGLImplementationDisabledName;
+
+    // Keep a GL implementation available for the software scene graph so that
+    // WebGL can be served by a software renderer instead of failing to create
+    // any context at all.
+    if (!usingSupportedSGBackend() && !usingSoftwareSGBackend())
         return gl::kGLImplementationDisabledName;
 
     return gl::kGLImplementationANGLEName;
@@ -218,6 +245,11 @@
     if (getGLType(cmd) == gl::kGLImplementationANGLEName) {
         if (cmd.HasSwitch(switches::kUseANGLE))
             return cmd.GetSwitchValueASCII(switches::kUseANGLE);
+
+        // The software scene graph cannot share hardware GL contexts with
+        // Chromium, so use ANGLE's CPU based D3D11 WARP backend instead.
+        if (usingSoftwareSGBackend())
+            return gl::kANGLEImplementationD3D11WarpName;
 
         return gl::kANGLEImplementationDefaultName;
     }
@@ -712,12 +744,19 @@
             parsedCommandLine.AppendSwitch(switches::kDisableGpu);
     } else {
         // Warn on custom --use-gl if hardware rendering is disabled.
-        if (!usingSupportedSGBackend())
+        if (!usingSupportedSGBackend() && !usingSoftwareSGBackend())
             qWarning("--use-gl=%s is set with unsupported SceneGraph Backend. Expect troubles!",
                      glType.c_str());
 
         if (parsedCommandLine.HasSwitch(switches::kDisableGpu))
             qWarning("--use-gl=%s is set with --disable-gpu. Expect troubles!", glType.c_str());
+    }
+
+    // A software scene graph cannot present GPU composited frames, so keep the
+    // compositor on the CPU while ANGLE's WARP backend serves WebGL and canvas.
+    if (usingSoftwareSGBackend() && !parsedCommandLine.HasSwitch(switches::kDisableGpu)
+        && !parsedCommandLine.HasSwitch(switches::kDisableGpuCompositing)) {
+        parsedCommandLine.AppendSwitch(switches::kDisableGpuCompositing);
     }
 
 #if BUILDFLAG(IS_OZONE)
@@ -775,8 +814,9 @@
 #endif // BUILDFLAG(IS_OZONE)
 
 #if defined(Q_OS_WIN)
-    if (QQuickWindow::graphicsApi() == QSGRendererInterface::Direct3D11
-        || QQuickWindow::graphicsApi() == QSGRendererInterface::Vulkan) {
+    if (usingSupportedSGBackend()
+        && (QQuickWindow::graphicsApi() == QSGRendererInterface::Direct3D11
+            || QQuickWindow::graphicsApi() == QSGRendererInterface::Vulkan)) {
         const QString luid = RhiGpuInfo::instance()->getAdapterLuid();
         if (!luid.isEmpty())
             parsedCommandLine.AppendSwitchASCII(switches::kUseAdapterLuid, luid.toStdString());
